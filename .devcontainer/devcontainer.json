{
  "name": "CortexFlow Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.9-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 8000, 8001],
  "portsAttributes": {
    "3000": {
      "label": "Frontend",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8000": {
      "label": "Gateway API",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "8001": {
      "label": "Test Runner",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "echo 'Codespace created! Run docker-compose up --build to start the stack.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
